<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Flip animation triggered by tapping the layout -->
    <Transition
        app:constraintSetStart="@id/start"
        app:constraintSetEnd="@id/end"
        app:duration="600">
        <OnClick
            app:targetId="@id/cardFront"
            app:clickAction="toggle" />
    </Transition>

    <ConstraintSet android:id="@+id/start">
        <Constraint android:id="@id/cardFront">
            <Transform android:rotationY="0" />
            <PropertySet android:alpha="1" />
        </Constraint>
        <Constraint android:id="@id/cardBack">
            <Transform android:rotationY="-180" />
            <PropertySet android:alpha="0" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint android:id="@id/cardFront">
            <Transform android:rotationY="180" />
            <PropertySet android:alpha="0" />
        </Constraint>
        <Constraint android:id="@id/cardBack">
            <Transform android:rotationY="0" />
            <PropertySet android:alpha="1" />
        </Constraint>
    </ConstraintSet>

    <!-- KeyFrames to handle alpha mid-transition to avoid both cards being visible or invisible simultaneously -->
    <Transition
        app:constraintSetStart="@id/start"
        app:constraintSetEnd="@id/end">
        <KeyFrameSet>
            <KeyAttribute
                app:framePosition="50"
                app:motionTarget="@id/cardFront"
                android:alpha="0" />
            <KeyAttribute
                app:framePosition="50"
                app:motionTarget="@id/cardBack"
                android:alpha="0" />
        </KeyFrameSet>
    </Transition>

</MotionScene>
